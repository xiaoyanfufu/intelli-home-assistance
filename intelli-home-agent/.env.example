# Agent 服务配置
# 复制为 .env 后填写真实值。.env 必须加入 .gitignore。

# ── LLM 配置（OpenAI 兼容接口，可指向 DeepSeek / 通义 / 本地 Ollama）──
# DeepSeek 示例：LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# ── 天气服务 ──
# 配置供应商 API Key、账户对应的 API Host 和位置
WEATHER_API_KEY=
WEATHER_API_HOST=https://devapi.qweather.com
WEATHER_LOCATION=101280601

# ── 服务自身 ──
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
