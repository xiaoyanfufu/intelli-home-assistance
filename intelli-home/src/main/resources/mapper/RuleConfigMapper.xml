<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.intelli.home.adapter.out.persistence.mapper.RuleConfigMapper">
  <resultMap id="ruleRow" type="com.intelli.home.adapter.out.persistence.model.RuleConfigRow">
    <id column="rule_code" property="ruleCode"/>
    <result column="enabled" property="enabled"/>
    <result column="priority" property="priority"/>
    <result column="params_json" property="paramsJson"/>
  </resultMap>
  <select id="findAll" resultMap="ruleRow">
    SELECT rule_code, enabled, priority, params_json FROM rule_config
  </select>
</mapper>
